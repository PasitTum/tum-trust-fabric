# ==============================================================================
# TUM Sovereign Corridor Gateway — Environment Configuration Template
# Copy this file to .env before starting the appliance stack
# ==============================================================================

# Server Network Configuration
PORT=8088
NODE_ENV=production

# Airport & Checkpoint Identification
AIRPORT_CODE=BKK
APPLIANCE_ID=TUM-SOVEREIGN-CORRIDOR-01
CORRIDOR_GATE_ID=BKK-SUVARNABHUMI-T1-GATE01
TERMINAL_ZONE=INTERNATIONAL_DEPARTURES_CONCOURSE_D

# Biometric & Anti-Spoofing Thresholds (ISO/IEC 19794-5 & 30107-3)
BIOMETRIC_MATCH_THRESHOLD=0.85
BIOMETRIC_LIVENESS_THRESHOLD=0.90
UWB_DISTANCE_THRESHOLD_METERS=1.5

# Cryptographic & Post-Quantum Specifications (FIPS 204 / FIPS 203)
PQC_SECURITY_LEVEL=ML-DSA-65
PQC_TLS_HANDSHAKE_MODE=HYBRID_X25519_ML_KEM_768

# ICAO Doc 9303 Public Key Directory (PKD) Configuration
ICAO_PKD_AUTO_SYNC_ENABLED=true
ICAO_PKD_SYNC_INTERVAL_HOURS=24
ICAO_CERTS_DIR=/app/certs

# Offline Edge Kiosk Mode
OFFLINE_CACHE_TTL_HOURS=72
EDGE_STORAGE_DIR=/app/data
AUDIT_STORAGE_DIR=/app/audit

# High-Speed Cache Connection
REDIS_URL=redis://tum-corridor-edge-cache:6379
